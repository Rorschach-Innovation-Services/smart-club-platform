.DS_Store
.vscode/
.idea/
node_modules/
dist/
.sst/
sst-env.d.ts
*.log
.env
.env*.local
# Sentry source-map upload auth token (read by @sentry/vite-plugin at build time)
.env.sentry-build-plugin
.claude/

# Playwright MCP test artifacts
.playwright-mcp/
dash.md

# Prod data snapshots written by import-planb-fixtures --confirm — never commit
planb-backup-*.json
venue-merge-backup-*.json
venue-normalise-backup-*.json
venue-clash-resolve-backup-*.json
packages/api/*-backup-*.json

# Prod data snapshots (chair name/email/cell, docMeta) written by
# import-titans-compliance --confirm — never commit; also covers the
# titans-import-created-clubs.json revert manifest, which carries no PII itself
# but lives alongside the backups and is equally not repo content.
titans-import-backup-*.json
titans-import-created-clubs.json
titans-import-created-clubs.*.json

# Prod data snapshots (chair/office-bearer name/email/cell) written by
# import-titans-contacts --confirm — never commit. The revert manifest carries PII
# (per-person pre-image memberships) too, so both patterns stay out of the repo.
titans-contacts-import-backup-*.json
titans-contacts-import-manifest.json

# Prod data snapshots written by import-tuskers-compliance --confirm, plus its
# created-clubs revert manifests (legacy unsuffixed + stage-scoped .<stage>.json) — same
# reasoning as the titans pair above.
tuskers-import-backup-*.json
tuskers-import-created-clubs.json
tuskers-import-created-clubs.*.json

# import-lions-affiliation --confirm backups (club records incl. officer contacts — PII) and
# its created-clubs revert manifests (legacy unsuffixed + stage-scoped .<stage>.json).
lions-affiliation-backup-*.json
lions-affiliation-created-clubs.json
lions-affiliation-created-clubs.*.json

# import-lions-fixtures --confirm / --revert --confirm series snapshots.
lions-fixtures-backup-*.json

# import-lions-compliance --confirm club snapshots and its created-clubs revert manifests
# (legacy unsuffixed + stage-scoped .<stage>.json).
lions-import-backup-*.json
lions-import-created-clubs.json
lions-import-created-clubs.*.json

# import-lions-contacts --confirm club snapshots and its revert manifests (per-person
# pre-image memberships — PII; legacy unsuffixed + stage-scoped .<stage>.json).
lions-contacts-import-backup-*.json
lions-contacts-import-manifest.json
lions-contacts-import-manifest.*.json

# send-dolphins-welcome-broadcast run manifests (dry-run + --confirm): every recipient's name,
# email, cell and message ids — PII, never commit.
dolphins-welcome-broadcast-*.json
# …and its delivery reports (report-dolphins-welcome-broadcast.ts) — names, contacts, statuses.
dolphins-welcome-broadcast-report-*.html
dolphins-welcome-broadcast-report-*.pdf
# send-emcu-scorer-broadcast run manifests + reports (names, contacts, statuses — never
# credentials, but still PII).
emcu-scorer-broadcast-*.json
emcu-scorer-broadcast-report-*.html
emcu-scorer-broadcast-report-*.pdf
# MediCoach scorer credentials (passwords) — belongs outside both repos; belt and braces.
emcu-scorer-credentials*.json

# generated cohort exports (contain PII)
cohort-export-*.xlsx

# Playwright E2E (browser-driven admin tests)
test-results/
playwright-report/

# MedicoachBundle exports from export-medicoach (names, emails, cells, dates of birth) —
# never commit. Default --out names like dolphins-bundle.json / dolphins-bundle-dev.json.
# The pinned test inputs under packages/api/test/data/medicoach/ don't match either pattern.
*-bundle*.json
*medicoach*bundle*.json
# make-medicoach-e2e-bundle output (synthetic people, but a generated artifact — never
# commit). Exact names, so the pinned inputs under packages/api/test/data/medicoach/
# (dolphins-*.json) stay tracked.
bundle-full.json
bundle-small.json
people-cases.json
results.json
results-bad.json
results-phase1.json
