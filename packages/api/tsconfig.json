{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node", "aws-lambda"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
  // seed-cohort.ts / export-cohort.ts import from the frontend tree (src/competition/*,
  // src/data.ts, src/cqiScore.ts), which is authored under `strict: false`. Nothing in the
  // api tree imports them back, so excluding them keeps THIS project strict; they are
  // type-checked by tsconfig.seed.json instead and both run in the `typecheck` script.
  "exclude": ["src/seed-cohort.ts", "src/export-cohort.ts"]
}
